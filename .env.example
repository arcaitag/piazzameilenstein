# Öffentliche Adresse der Website (für Sitemap, Canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://piazza-meilenstein.vercel.app

# Suchmaschinen erst zulassen, wenn Domain und Angaben final sind
ALLOW_INDEXING=false

# --- Formular-Versand (nur serverseitig, nie im Code ablegen) ---
# Empfänger aller Anfragen (Reservation, Anlass, Kontakt)
MAIL_TO=
# Absender, z. B. "Piazza Meilenstein <anfragen@ihre-domain.ch>" (Domain beim Versanddienst verifiziert)
MAIL_FROM=

# Variante A: Resend (https://resend.com)
RESEND_API_KEY=

# Variante B: SMTP des eigenen Mailanbieters
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true für Port 465 (implizites TLS)
SMTP_SECURE=false

# Optional: Gäste erhalten eine Eingangsbestätigung (keine Reservationsbestätigung)
SEND_GUEST_COPY=false
